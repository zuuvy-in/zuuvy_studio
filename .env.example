# Copy to .env. Every process (both apps, the worker, scripts) reads this one file.

# The app connects as zsite_app, which Row-Level Security binds; migrations run as the owner.
DATABASE_URL=postgres://zsite_app:zsite@127.0.0.1:54329/zsite
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:54329/zsite

# Sites live at <name>.zuuvy.site in production; *.localhost resolves to your machine.
PLATFORM_DOMAIN=zuuvy.site
SITE_URL_TEMPLATE=http://{sub}.localhost:3001

# Where Zuuvy sends webhooks. Must be reachable from Zuuvy (the mock runs locally).
PUBLIC_API_URL=http://127.0.0.1:3000

# 32 random bytes, base64: `openssl rand -base64 32`. Seals integration credentials.
# Unset in development = a fixed development key; production refuses to start without it.
SECRETS_KEY=

# AI editing. Without it configured the studio works and "Describe a change" is disabled.
# bedrock = Amazon Nova through Amazon Bedrock (AWS's own models, covered by AWS credits).
# anthropic = Claude through Anthropic's API (needs ANTHROPIC_API_KEY).
ZSITE_AI_PROVIDER=bedrock
# Empty = the provider's default: apac.amazon.nova-pro-v1:0 (Bedrock) / claude-opus-5 (Anthropic).
# Bedrock ids are region-specific; e.g. us.amazon.nova-premier-v1:0 with AWS_REGION=us-east-1.
ZSITE_AI_MODEL=
# Used when ZSITE_AI_MODEL cannot be (not enabled on the account, IAM, region).
# Empty = the provider's default model; "none" = fail instead.
ZSITE_AI_FALLBACK_MODEL=
AWS_REGION=ap-south-1
# Bedrock credentials come from the AWS SDK chain: AWS_PROFILE, or the two keys below.
# In production leave them out and grant the service's IAM role bedrock:InvokeModel.
# AWS_PROFILE=your-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
ANTHROPIC_API_KEY=

# Zuuvy's channel API. In development this points at the mock (npm run mock:zuuvy).
ZUUVY_API_URL=http://127.0.0.1:4010
# Lets the connect form name a different API URL. Never set in production.
ZSITE_ALLOW_CUSTOM_ZUUVY_URL=0

# Pictures (media library). Unset = uploads and AI pictures are off with a clear message.
# ASSETS_BUCKET=your-bucket          (objects under t/ must be publicly readable)
# ASSETS_BASE_URL=                   (default https://<bucket>.s3.<region>.amazonaws.com)
# Image model for generate_image: Nova 2 Omni (Converse) through its global profile.
# amazon.nova-canvas-v1:0 with ZSITE_IMAGE_REGION=us-east-1 still works where the account used it recently (Legacy).
ZSITE_IMAGE_MODEL=global.amazon.nova-2-omni-v1:0
ZSITE_IMAGE_REGION=

# Email through Amazon SES, from alerts@ and no-reply@ on EMAIL_DOMAIN.
# Off = messages are logged instead of sent.
EMAIL_ENABLED=0
EMAIL_DOMAIN=zuuvy.site

# Custom domains: where owners point their CNAME. Without a listener ARN (a laptop)
# a domain goes active on DNS alone and no certificate is requested.
# CUSTOM_DOMAIN_TARGET=domains.zuuvy.site
# ZSITE_DOMAIN_LISTENER_ARN=

# The first platform superadmin (npm run admin:create).
# SUPERADMIN_EMAIL=rishav@zuuvy.in
# SUPERADMIN_PASSWORD=

# Design helpers for the AI editor (MCP). The built-in design kit (palettes,
# font pairings, style recipes, contrast) is always on; photo search needs one key.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# Remote MCP servers (streamable HTTP), JSON:
# [{"name":"ui","url":"https://example.com/mcp","headers":{"Authorization":"Bearer ..."},"tools":["only_this"]}]
ZSITE_MCP_SERVERS=
# Icons8 (icons + Ouch illustrations), no key needed for free assets:
# ZSITE_MCP_SERVERS=[{"name":"icons8","url":"https://mcp.icons8.com/mcp/"}]

# Pictures are never generated unless this is 1 (then ZSITE_IMAGE_MODEL is used).
# ZSITE_IMAGE_GENERATION=0
# Hosts the AI's save_image may copy illustrations/icons from (https only, comma list, *. wildcards).
# ZSITE_IMPORT_HOSTS=img.icons8.com,*.icons8.com
